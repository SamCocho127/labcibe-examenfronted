# URL pública del backend en MonsterASP.
# En Netlify: dejar vacío (usa el proxy de netlify.toml → investigation2prograiv.runasp.net).
# En desarrollo local: vacío usa el proxy de vite.config.ts → localhost:5219.
# Para probar contra MonsterASP en local, descomenta la línea siguiente:
# VITE_API_URL=http://investigation2prograiv.runasp.net

VITE_REPORTS_URL=/reportar-estafa
VITE_REPORTS_LIST_URL=/reportes
